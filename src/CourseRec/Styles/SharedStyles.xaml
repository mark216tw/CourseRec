<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light" Source="ms-appx:///Styles/Themes/LightTheme.xaml" />
        <ResourceDictionary x:Key="Dark" Source="ms-appx:///Styles/Themes/DarkTheme.xaml" />
        <ResourceDictionary x:Key="Default" Source="ms-appx:///Styles/Themes/DarkTheme.xaml" />
    </ResourceDictionary.ThemeDictionaries>

    <!-- Shared Font Sizes -->
    <x:Double x:Key="FontSizeHeroTime">28</x:Double>
    <x:Double x:Key="FontSizePageTitle">24</x:Double>
    <x:Double x:Key="FontSizeSectionHeader">16</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>

    <!-- Shared CornerRadius & Spacing (multiples of 4) -->
    <CornerRadius x:Key="SharedCornerRadius">8</CornerRadius>
    <Thickness x:Key="PageContentPadding">24</Thickness>
    <Thickness x:Key="CardInternalPadding">16</Thickness>
    <Thickness x:Key="SubtleBadgePadding">8,4,8,4</Thickness>
    <Thickness x:Key="CardBorderThickness">1</Thickness>

    <!-- Shared Card Border Style -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource CardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource SharedCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardInternalPadding}" />
    </Style>

    <Style x:Key="SubtlePanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardSubtleSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource CardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource SharedCornerRadius}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Shared TextBlock Styles -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSectionHeader}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="BodyPrimaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="CaptionSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="HeroTimecodeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeroTime}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="MonoBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource BrandAccentBrush}" />
    </Style>
</ResourceDictionary>
