<Page
    x:Class="Com.VibeCode.CourseRec.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Com.VibeCode.CourseRec.Models">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearchAcceleratorInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnClearSearchAcceleratorInvoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Actions -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Uid="LibraryPageTitle" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Uid="LibraryPageSubtitle" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    x:Uid="BtnRefreshLibrary"
                    Command="{x:Bind ViewModel.RefreshLibraryCommand}" />
                <Button
                    x:Uid="BtnOpenOutputFolder"
                    Command="{x:Bind ViewModel.OpenOutputFolderCommand}" />
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <!-- Search -->
        <Grid Grid.Row="2">
            <TextBox
                x:Name="SearchBox"
                x:Uid="TxtLibrarySearch"
                Padding="12,8,44,8"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                x:Uid="BtnClearLibrarySearch"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="32"
                Height="32"
                Margin="0,0,4,0"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Visibility="{x:Bind ViewModel.SearchClearVisibility, Mode=OneWay}"
                Command="{x:Bind ViewModel.ClearSearchCommand}">
                <SymbolIcon Symbol="Clear" />
            </Button>
        </Grid>

        <!-- Count & Sort -->
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.RecordingCountText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                <TextBlock
                    Text="{x:Bind ViewModel.TotalSizeText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.TotalSizeVisibility, Mode=OneWay}"
                    Style="{StaticResource CaptionSecondaryTextStyle}" />
                <TextBlock
                    Text="{x:Bind ViewModel.TotalDurationText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.TotalSizeVisibility, Mode=OneWay}"
                    Style="{StaticResource CaptionSecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Uid="LblLibrarySort" Style="{StaticResource CaptionSecondaryTextStyle}" VerticalAlignment="Center" />
                <ComboBox
                    x:Uid="CmbLibrarySort"
                    MinWidth="150"
                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="4">
            <Border
                Visibility="{x:Bind ViewModel.NoSearchResultsVisibility, Mode=OneWay}"
                Style="{StaticResource CardBorderStyle}"
                VerticalAlignment="Top">
                <TextBlock x:Uid="LibraryNoSearchResults" Style="{StaticResource BodyPrimaryTextStyle}" />
            </Border>

            <StackPanel
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"
                HorizontalAlignment="Center"
                Padding="32"
                Spacing="12"
                VerticalAlignment="Top">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="40" Height="40" />
            </StackPanel>

            <Border
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}"
                Style="{StaticResource CardBorderStyle}"
                VerticalAlignment="Top">
                <StackPanel Spacing="8" HorizontalAlignment="Center" Padding="32">
                    <SymbolIcon Symbol="Video" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Uid="LibraryEmptyTitle" Style="{StaticResource SectionHeaderTextStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Uid="LibraryEmptySubtitle" Style="{StaticResource CaptionSecondaryTextStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ListView
                Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.FilteredRecordings}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4,0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:RecordingLibraryItem">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="56"
                                    Height="56"
                                    Background="{ThemeResource CardSubtleSurfaceBrush}"
                                    CornerRadius="{StaticResource SharedCornerRadius}">
                                    <SymbolIcon Symbol="Video" Foreground="{ThemeResource BrandAccentBrush}" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="4"
                                    VerticalAlignment="Center"
                                    Tag="{x:Bind}"
                                    DoubleTapped="OnRecordingItemDoubleTapped">
                                    <TextBlock Text="{x:Bind FileName}" Style="{StaticResource SectionHeaderTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FileName}" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{x:Bind CreatedAtText}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                        <TextBlock Text="{x:Bind DurationText}" Style="{StaticResource MonoBadgeTextStyle}" />
                                        <TextBlock
                                            Text="{x:Bind FileSizeBytes, Converter={StaticResource FileSizeConverter}}"
                                            Style="{StaticResource CaptionSecondaryTextStyle}" />
                                        <TextBlock Text="{x:Bind BookmarkBadgeText}" Style="{StaticResource MonoBadgeTextStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button
                                        x:Uid="BtnLibraryPlay"
                                        Tag="{x:Bind}"
                                        Click="OnPlayItemClicked" />
                                    <Button
                                        x:Uid="BtnLibraryOpenEditor"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Tag="{x:Bind}"
                                        Click="OnOpenInEditorClicked" />
                                    <Button x:Uid="BtnLibraryMore">
                                        <SymbolIcon Symbol="More" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem x:Uid="MenuLibraryRename" Tag="{x:Bind}" Click="OnRenameItemClicked" />
                                                <MenuFlyoutItem x:Uid="MenuLibraryRevealFile" Tag="{x:Bind}" Click="OnRevealFileClicked" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="MenuLibraryDelete" Tag="{x:Bind}" Click="OnDeleteItemClicked" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
