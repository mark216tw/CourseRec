<Page
    x:Class="Com.VibeCode.CourseRec.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Com.VibeCode.CourseRec.Models">

    <Page.Resources>
        <Style x:Key="ThemeColorFlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="12" />
            <Setter Property="MaxWidth" Value="320" />
        </Style>

        <DataTemplate x:Key="ColorThemeSwatchTemplate" x:DataType="models:ColorThemeOption">
            <Border
                Width="44"
                Height="24"
                CornerRadius="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{ThemeResource CardStrokeBrush}"
                BorderThickness="1"
                AutomationProperties.Name="{x:Bind DisplayText}">
                <Border.Background>
                    <SolidColorBrush Color="{x:Bind AccentColor}" />
                </Border.Background>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PageContentPadding}">
        <StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="SettingsPageTitle" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Uid="SettingsPageSubtitle" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <InfoBar
                x:Name="StatusInfoBar"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

            <!-- Display Theme -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsSectionAppearance" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ComboBox
                        x:Uid="CmbDisplayMode"
                        MinWidth="260"
                        HorizontalAlignment="Left"
                        ItemsSource="{x:Bind ViewModel.DisplayModeOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedDisplayModeOption, Mode=TwoWay}" />
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="TxtColorTheme" Style="{StaticResource BodyPrimaryTextStyle}" />
                        <Button
                            x:Uid="BtnColorTheme"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ContentControl
                                    Content="{x:Bind ViewModel.SelectedColorThemeOption, Mode=OneWay}"
                                    ContentTemplate="{StaticResource ColorThemeSwatchTemplate}"
                                    IsTabStop="False" />
                                <FontIcon FontSize="12" Glyph="&#xE70D;" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout
                                    x:Name="ColorThemeFlyout"
                                    Placement="Bottom"
                                    FlyoutPresenterStyle="{StaticResource ThemeColorFlyoutPresenterStyle}">
                                    <StackPanel Spacing="8" MinWidth="260">
                                        <TextBlock x:Uid="ThemeColorFlyoutTitle" Style="{StaticResource SectionHeaderTextStyle}" />
                                        <GridView
                                            x:Uid="GridViewColorThemes"
                                            Width="260"
                                            Height="64"
                                            ItemsSource="{x:Bind ViewModel.ColorThemeOptions}"
                                            SelectedItem="{x:Bind ViewModel.SelectedColorThemeOption, Mode=TwoWay}"
                                            SelectionMode="Single"
                                            IsItemClickEnabled="True"
                                            ItemClick="OnColorThemeItemClick"
                                            ItemTemplate="{StaticResource ColorThemeSwatchTemplate}"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollMode="Disabled"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.HorizontalScrollMode="Disabled">
                                            <GridView.ItemContainerStyle>
                                                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                </Style>
                                            </GridView.ItemContainerStyle>
                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid
                                                        Orientation="Horizontal"
                                                        ItemWidth="52"
                                                        ItemHeight="32"
                                                        MaximumRowsOrColumns="5" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>
                                        </GridView>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Recording -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsSectionRecording" Style="{StaticResource SectionHeaderTextStyle}" />
                    <StackPanel Spacing="4">
                        <ComboBox
                            x:Uid="CmbRecordingCountdown"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.CountdownOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedCountdownOption, Mode=TwoWay}" />
                        <TextBlock x:Uid="CmbRecordingCountdownDescription" Style="{StaticResource CaptionSecondaryTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Uid="SwLivePreviewDefault"
                        IsOn="{x:Bind ViewModel.IsLivePreviewEnabledByDefault, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Storage & Overlay -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsSectionStorage" Style="{StaticResource SectionHeaderTextStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            x:Uid="TxtOutputDirectory"
                            Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay}" />
                        <Button
                            Grid.Column="1"
                            x:Uid="BtnBrowseOutputDir"
                            VerticalAlignment="Bottom"
                            Click="OnBrowseOutputDirectoryClicked" />
                        <Button
                            Grid.Column="2"
                            x:Uid="BtnOpenOutputDir"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.OpenOutputDirectoryCommand}">
                            <SymbolIcon Symbol="OpenFile" />
                        </Button>
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBox
                            x:Uid="TxtRecordingFileNamePrefix"
                            Text="{x:Bind ViewModel.RecordingFileNamePrefix, Mode=TwoWay}" />
                        <TextBlock x:Uid="TxtRecordingFileNamePrefixDescription" Style="{StaticResource CaptionSecondaryTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Uid="SwExcludeOverlay"
                        IsOn="{x:Bind ViewModel.ExcludeOverlayFromCapture, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Hotkeys -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsSectionHotkeys" Style="{StaticResource SectionHeaderTextStyle}" />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="0"
                            x:Uid="TxtHotkeyStartStop"
                            Text="{x:Bind ViewModel.ToggleStartStopHotkey, Mode=TwoWay}"
                            PreviewKeyDown="OnHotkeyTextBoxPreviewKeyDown" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            x:Uid="TxtHotkeyPause"
                            Text="{x:Bind ViewModel.TogglePauseHotkey, Mode=TwoWay}"
                            PreviewKeyDown="OnHotkeyTextBoxPreviewKeyDown" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="0"
                            x:Uid="TxtHotkeyBookmark"
                            Text="{x:Bind ViewModel.AddBookmarkHotkey, Mode=TwoWay}"
                            PreviewKeyDown="OnHotkeyTextBoxPreviewKeyDown" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            x:Uid="TxtHotkeySnapshot"
                            Text="{x:Bind ViewModel.TakeSnapshotHotkey, Mode=TwoWay}"
                            PreviewKeyDown="OnHotkeyTextBoxPreviewKeyDown" />
                    </Grid>
                    <Button
                        x:Uid="BtnResetHotkeys"
                        HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.ResetHotkeysToDefaultsCommand}" />
                </StackPanel>
            </Border>

            <Button
                x:Uid="BtnSaveSettings"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.SaveSettingsCommand}" />
        </StackPanel>
    </ScrollViewer>
</Page>
