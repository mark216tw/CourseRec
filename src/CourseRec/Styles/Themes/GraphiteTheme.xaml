<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackgroundColor">#FFECEFF1</Color>
            <Color x:Key="CardSurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="CardSubtleSurfaceColor">#FFDDE3E8</Color>
            <Color x:Key="CardStrokeColor">#FFB0BEC5</Color>
            <Color x:Key="PrimaryTextColor">#FF1B242B</Color>
            <Color x:Key="SecondaryTextColor">#FF4A5A66</Color>
            <Color x:Key="BrandAccentColor">#FF455A64</Color>
            <Color x:Key="RecordingActiveColor">#FFC62828</Color>
            <Color x:Key="RecordingPausedColor">#FFC77700</Color>
            <Color x:Key="MeterSafeColor">#FF1B7F3A</Color>
            <Color x:Key="PreviewBackdropColor">#FF10181D</Color>
            <Color x:Key="OverlayBackgroundColor">#F2FFFFFF</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
            <SolidColorBrush x:Key="CardSubtleSurfaceBrush" Color="{StaticResource CardSubtleSurfaceColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="RecordingActiveBrush" Color="{StaticResource RecordingActiveColor}" />
            <SolidColorBrush x:Key="RecordingPausedBrush" Color="{StaticResource RecordingPausedColor}" />
            <SolidColorBrush x:Key="MeterSafeBrush" Color="{StaticResource MeterSafeColor}" />
            <SolidColorBrush x:Key="PreviewBackdropBrush" Color="{StaticResource PreviewBackdropColor}" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="{StaticResource OverlayBackgroundColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppBackgroundColor">#FF0B1115</Color>
            <Color x:Key="CardSurfaceColor">#FF161F26</Color>
            <Color x:Key="CardSubtleSurfaceColor">#FF223039</Color>
            <Color x:Key="CardStrokeColor">#FF33444F</Color>
            <Color x:Key="PrimaryTextColor">#FFECEFF1</Color>
            <Color x:Key="SecondaryTextColor">#FFA5B4BE</Color>
            <Color x:Key="BrandAccentColor">#FF90A4AE</Color>
            <Color x:Key="RecordingActiveColor">#FFEF5350</Color>
            <Color x:Key="RecordingPausedColor">#FFFFA726</Color>
            <Color x:Key="MeterSafeColor">#FF66BB6A</Color>
            <Color x:Key="PreviewBackdropColor">#FF05080A</Color>
            <Color x:Key="OverlayBackgroundColor">#F2161F26</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
            <SolidColorBrush x:Key="CardSubtleSurfaceBrush" Color="{StaticResource CardSubtleSurfaceColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="RecordingActiveBrush" Color="{StaticResource RecordingActiveColor}" />
            <SolidColorBrush x:Key="RecordingPausedBrush" Color="{StaticResource RecordingPausedColor}" />
            <SolidColorBrush x:Key="MeterSafeBrush" Color="{StaticResource MeterSafeColor}" />
            <SolidColorBrush x:Key="PreviewBackdropBrush" Color="{StaticResource PreviewBackdropColor}" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="{StaticResource OverlayBackgroundColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="AppBackgroundColor">#FF0B1115</Color>
            <Color x:Key="CardSurfaceColor">#FF161F26</Color>
            <Color x:Key="CardSubtleSurfaceColor">#FF223039</Color>
            <Color x:Key="CardStrokeColor">#FF33444F</Color>
            <Color x:Key="PrimaryTextColor">#FFECEFF1</Color>
            <Color x:Key="SecondaryTextColor">#FFA5B4BE</Color>
            <Color x:Key="BrandAccentColor">#FF90A4AE</Color>
            <Color x:Key="RecordingActiveColor">#FFEF5350</Color>
            <Color x:Key="RecordingPausedColor">#FFFFA726</Color>
            <Color x:Key="MeterSafeColor">#FF66BB6A</Color>
            <Color x:Key="PreviewBackdropColor">#FF05080A</Color>
            <Color x:Key="OverlayBackgroundColor">#F2161F26</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
            <SolidColorBrush x:Key="CardSubtleSurfaceBrush" Color="{StaticResource CardSubtleSurfaceColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="RecordingActiveBrush" Color="{StaticResource RecordingActiveColor}" />
            <SolidColorBrush x:Key="RecordingPausedBrush" Color="{StaticResource RecordingPausedColor}" />
            <SolidColorBrush x:Key="MeterSafeBrush" Color="{StaticResource MeterSafeColor}" />
            <SolidColorBrush x:Key="PreviewBackdropBrush" Color="{StaticResource PreviewBackdropColor}" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="{StaticResource OverlayBackgroundColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
