<Page
    x:Class="Com.VibeCode.CourseRec.Views.RecorderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Com.VibeCode.CourseRec.Models">

    <ScrollViewer Padding="{StaticResource PageContentPadding}">
        <StackPanel Spacing="8">
            <!-- Header & Status Hero -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Uid="RecorderPageTitle" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock x:Uid="RecorderPageSubtitle" Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource SubtlePanelBorderStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Fill="{ThemeResource SecondaryTextBrush}" Visibility="{x:Bind ViewModel.IdleIndicatorVisibility, Mode=OneWay}" />
                            <Ellipse Width="12" Height="12" Fill="{ThemeResource RecordingActiveBrush}" Visibility="{x:Bind ViewModel.ActiveIndicatorVisibility, Mode=OneWay}" />
                            <Ellipse Width="12" Height="12" Fill="{ThemeResource RecordingPausedBrush}" Visibility="{x:Bind ViewModel.PausedIndicatorVisibility, Mode=OneWay}" />
                            <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsFinalizing, Mode=OneWay}" Visibility="{x:Bind ViewModel.FinalizingVisibility, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusBadgeText, Mode=OneWay}"
                            Style="{StaticResource BodyPrimaryTextStyle}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ElapsedTimeText, Mode=OneWay}"
                            Style="{StaticResource HeroTimecodeTextStyle}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar
                x:Name="StatusInfoBar"
                IsOpen="{x:Bind ViewModel.IsInfoBannerOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.InfoBannerMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.BannerSeverity, Mode=OneWay}" />

            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.CompletedRecordingVisibility, Mode=OneWay}">
                <Button x:Uid="BtnOpenCompletedRecording" Command="{x:Bind ViewModel.OpenCompletedRecordingCommand}" />
                <Button x:Uid="BtnRevealCompletedRecording" Command="{x:Bind ViewModel.RevealCompletedRecordingCommand}" />
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsMinimizedWarningOpen, Mode=OneWay}"
                IsClosable="False"
                Severity="Warning"
                Title="{x:Bind ViewModel.MinimizedWarningTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.MinimizedWarningMessage, Mode=OneWay}" />

            <!-- Main Two-Column Workspace -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Live Preview & Recording Controls -->
                <StackPanel Grid.Column="0" Spacing="16">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    x:Uid="RecorderSectionPreview"
                                    Style="{StaticResource SectionHeaderTextStyle}"
                                    VerticalAlignment="Center" />
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.LivePreviewStateText, Mode=OneWay}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyPrimaryTextStyle}" />
                                    <ToggleSwitch
                                        HorizontalAlignment="Right"
                                        MinWidth="0"
                                        Margin="0,0,-12,0"
                                        OnContent=""
                                        OffContent=""
                                        AutomationProperties.Name="{x:Bind ViewModel.LivePreviewAutomationName, Mode=OneWay}"
                                        IsOn="{x:Bind ViewModel.IsLivePreviewEnabled, Mode=TwoWay}"
                                        Toggled="OnLivePreviewToggled" />
                                </StackPanel>
                            </Grid>
                            <Border
                                Background="{ThemeResource PreviewBackdropBrush}"
                                CornerRadius="{StaticResource SharedCornerRadius}"
                                MinHeight="320"
                                MaxHeight="440">
                                <Grid>
                                    <TextBlock
                                        x:Name="PreviewPlaceholderText"
                                        x:Uid="RecorderPreviewEmpty"
                                        Style="{StaticResource CaptionSecondaryTextStyle}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <Image
                                        x:Name="PreviewImage"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Recording Action Bar & Bookmark Input -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="RecorderSectionControls" Style="{StaticResource SectionHeaderTextStyle}" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="{x:Bind ViewModel.StartRecordingButtonText, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ViewModel.StartRecordingAutomationName, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.StartRecordingCommand}" />
                                <Button
                                    Content="{x:Bind ViewModel.PauseResumeText, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ViewModel.PauseResumeText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanPauseOrResume, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.TogglePauseResumeCommand}" />
                                <Button
                                    Content="{x:Bind ViewModel.StopButtonText, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ViewModel.StopButtonText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.StopRecordingCommand}" />
                                <Button
                                    x:Uid="BtnToggleMiniOverlay"
                                    Command="{x:Bind ViewModel.ToggleMiniOverlayCommand}" />
                            </StackPanel>

                            <TextBlock
                                Text="{x:Bind ViewModel.HotkeySummaryText, Mode=OneWay}"
                                Style="{StaticResource CaptionSecondaryTextStyle}" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    x:Uid="TxtBookmarkNote"
                                    Text="{x:Bind ViewModel.BookmarkNoteInput, Mode=TwoWay}"
                                    KeyDown="OnBookmarkNoteKeyDown" />
                                <Button
                                    Grid.Column="1"
                                    x:Uid="BtnAddBookmark"
                                    VerticalAlignment="Bottom"
                                    IsEnabled="{x:Bind ViewModel.CanBookmark, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.AddBookmarkCommand}" />
                                <Button
                                    Grid.Column="2"
                                    x:Uid="BtnTakeSnapshot"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.TakeSnapshotCommand}" />
                                <Button
                                    Grid.Column="3"
                                    x:Uid="BtnOpenSnapshotFolderRecorder"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.OpenSnapshotFolderCommand}">
                                    <SymbolIcon Symbol="OpenFile" />
                                </Button>
                            </Grid>

                            <ListView
                                x:Name="SessionBookmarksList"
                                ItemsSource="{x:Bind ViewModel.SessionBookmarks}"
                                SelectionMode="None"
                                MaxHeight="140">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:BookmarkItem">
                                        <Grid ColumnSpacing="12" Padding="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind FormattedTimestamp}" Style="{StaticResource MonoBadgeTextStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Note}" Style="{StaticResource BodyPrimaryTextStyle}" VerticalAlignment="Center" />
                                            <Button
                                                Grid.Column="2"
                                                x:Uid="BtnRemoveSessionBookmark"
                                                Tag="{x:Bind}"
                                                Click="OnRemoveSessionBookmarkClicked">
                                                <SymbolIcon Symbol="Delete" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Scenario, Source, Dual VU Meters, Schedule/Disk -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <!-- Scenario & Quality -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="RecorderSectionScenario" Style="{StaticResource SectionHeaderTextStyle}" />
                            <StackPanel Spacing="8">
                                <ToggleButton
                                    x:Uid="BtnScenarioListenOnly"
                                    HorizontalAlignment="Stretch"
                                    IsChecked="{x:Bind ViewModel.IsListenOnlySelected, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.SelectListenOnlyCommand}" />
                                <ToggleButton
                                    x:Uid="BtnScenarioMeeting"
                                    HorizontalAlignment="Stretch"
                                    IsChecked="{x:Bind ViewModel.IsMeetingSelected, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.SelectInteractiveMeetingCommand}" />
                            </StackPanel>
                            <ComboBox
                                x:Uid="CmbQualityPreset"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.CanChangeSource, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.QualityOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedQualityOption, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Capture Source -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="RecorderSectionSource" Style="{StaticResource SectionHeaderTextStyle}" />
                            <ComboBox
                                x:Uid="CmbCaptureKind"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.CanChangeSource, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.CaptureKindOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedCaptureKindOption, Mode=TwoWay}" />
                            <TextBlock
                                x:Uid="WindowTargetMinimizedHint"
                                Style="{StaticResource CaptionSecondaryTextStyle}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.WindowTargetHintVisibility, Mode=OneWay}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Grid.Column="0"
                                    x:Uid="CmbCaptureTarget"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.CanChangeSource, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.AvailableTargets}"
                                    SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:CaptureTarget">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center">
                                                    <FontIcon FontSize="14" Glyph="&#xE7F4;" />
                                                    <Image
                                                        Width="16"
                                                        Height="16"
                                                        Stretch="Uniform"
                                                        Source="{x:Bind Icon, Converter={StaticResource IconDataToImageSourceConverter}}" />
                                                </Grid>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button
                                    Grid.Column="1"
                                    x:Uid="BtnRefreshTargets"
                                    VerticalAlignment="Bottom"
                                    IsEnabled="{x:Bind ViewModel.CanChangeSource, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RefreshTargetsCommand}">
                                    <SymbolIcon Symbol="Refresh" />
                                </Button>
                            </Grid>
                            <ToggleSwitch
                                x:Uid="SwIsolateWindowAudio"
                                IsEnabled="{x:Bind ViewModel.IsWindowTargetSelected, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.IsolateWindowAudio, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Dual Live VU Meters -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="RecorderSectionAudioMeter" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SystemAudioSourceText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" TextWrapping="Wrap" />

                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="LblSystemAudioMeter" Style="{StaticResource BodyPrimaryTextStyle}" />
                                <ProgressBar
                                    Minimum="0"
                                    Maximum="100"
                                    Height="8"
                                    Foreground="{ThemeResource MeterSafeBrush}"
                                    Value="{x:Bind ViewModel.SystemMeterPercent, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Uid="LblMicAudioMeter" Style="{StaticResource BodyPrimaryTextStyle}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind ViewModel.MicrophoneStatusHint, Mode=OneWay}"
                                        Style="{StaticResource CaptionSecondaryTextStyle}" />
                                </Grid>
                                <ProgressBar
                                    Minimum="0"
                                    Maximum="100"
                                    Height="8"
                                    Foreground="{ThemeResource BrandAccentBrush}"
                                    Value="{x:Bind ViewModel.MicrophoneMeterPercent, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Auto-Stop & Disk Space -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="RecorderSectionSchedule" Style="{StaticResource SectionHeaderTextStyle}" />
                            <ComboBox
                                x:Uid="CmbAutoStop"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.AutoStopOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedAutoStopOption, Mode=TwoWay}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.AutoStopRemainingText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.AutoStopRemainingVisibility, Mode=OneWay}"
                                Style="{StaticResource MonoBadgeTextStyle}" />
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="LblDiskFreeTitle" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.DiskSpaceSummaryText, Mode=OneWay}" Style="{StaticResource MonoBadgeTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
