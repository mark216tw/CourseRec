<Window
    x:Class="Com.VibeCode.CourseRec.Views.CountdownOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootHost">
        <Grid.Resources>
            <Storyboard x:Name="CountdownTickStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="CountdownNumberTransform"
                    Storyboard.TargetProperty="ScaleX"
                    From="1.18"
                    To="1.0"
                    Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="CountdownNumberTransform"
                    Storyboard.TargetProperty="ScaleY"
                    From="1.18"
                    To="1.0"
                    Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="CountdownNumberText"
                    Storyboard.TargetProperty="Opacity"
                    From="0.6"
                    To="1.0"
                    Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <Border
            x:Name="RootBorder"
            Background="{ThemeResource OverlayBackgroundBrush}"
            BorderBrush="{ThemeResource BrandAccentBrush}"
            BorderThickness="2"
            CornerRadius="{StaticResource SharedCornerRadius}"
            Padding="24">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="CountdownNumberText"
                    Grid.Row="0"
                    Style="{StaticResource CountdownNumberTextStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <CompositeTransform x:Name="CountdownNumberTransform" />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Ellipse
                        Width="10"
                        Height="10"
                        Fill="{ThemeResource RecordingActiveBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Uid="CountdownOverlaySubtitle"
                        Style="{StaticResource SectionHeaderTextStyle}"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
