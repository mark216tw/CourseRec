<UserControl
    x:Class="Com.VibeCode.CourseRec.Controls.ToastPresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        x:Name="RootBorder"
        MaxWidth="560"
        Background="{ThemeResource CardSurfaceBrush}"
        BorderBrush="{ThemeResource CardStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource SharedCornerRadius}"
        Opacity="0"
        Padding="16,10"
        Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <SymbolIcon Symbol="Accept" Foreground="{ThemeResource BrandAccentBrush}" />
            <TextBlock
                x:Name="MessageText"
                Style="{StaticResource BodyPrimaryTextStyle}"
                VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
