<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackgroundColor">#FFFFF6D9</Color>
            <Color x:Key="CardSurfaceColor">#FFFFFDF4</Color>
            <Color x:Key="CardSubtleSurfaceColor">#FFF8E8B8</Color>
            <Color x:Key="CardStrokeColor">#FFE4CD87</Color>
            <Color x:Key="PrimaryTextColor">#FF2E2410</Color>
            <Color x:Key="SecondaryTextColor">#FF6E5B32</Color>
            <Color x:Key="BrandAccentColor">#FF9A6A00</Color>
            <Color x:Key="RecordingActiveColor">#FFC62828</Color>
            <Color x:Key="RecordingPausedColor">#FFC77700</Color>
            <Color x:Key="MeterSafeColor">#FF2E7D32</Color>
            <Color x:Key="PreviewBackdropColor">#FF2D2412</Color>
            <Color x:Key="OverlayBackgroundColor">#F2FFFDF4</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
            <SolidColorBrush x:Key="CardSubtleSurfaceBrush" Color="{StaticResource CardSubtleSurfaceColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="RecordingActiveBrush" Color="{StaticResource RecordingActiveColor}" />
            <SolidColorBrush x:Key="RecordingPausedBrush" Color="{StaticResource RecordingPausedColor}" />
            <SolidColorBrush x:Key="MeterSafeBrush" Color="{StaticResource MeterSafeColor}" />
            <SolidColorBrush x:Key="PreviewBackdropBrush" Color="{StaticResource PreviewBackdropColor}" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="{StaticResource OverlayBackgroundColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppBackgroundColor">#FF1F1A08</Color>
            <Color x:Key="CardSurfaceColor">#FF2E2710</Color>
            <Color x:Key="CardSubtleSurfaceColor">#FF423817</Color>
            <Color x:Key="CardStrokeColor">#FF5C4E22</Color>
            <Color x:Key="PrimaryTextColor">#FFFFF8E1</Color>
            <Color x:Key="SecondaryTextColor">#FFD4C48A</Color>
            <Color x:Key="BrandAccentColor">#FFFFC94D</Color>
            <Color x:Key="RecordingActiveColor">#FFEF5350</Color>
            <Color x:Key="RecordingPausedColor">#FFFFA726</Color>
            <Color x:Key="MeterSafeColor">#FF81C784</Color>
            <Color x:Key="PreviewBackdropColor">#FF120F05</Color>
            <Color x:Key="OverlayBackgroundColor">#F22E2710</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
            <SolidColorBrush x:Key="CardSubtleSurfaceBrush" Color="{StaticResource CardSubtleSurfaceColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="RecordingActiveBrush" Color="{StaticResource RecordingActiveColor}" />
            <SolidColorBrush x:Key="RecordingPausedBrush" Color="{StaticResource RecordingPausedColor}" />
            <SolidColorBrush x:Key="MeterSafeBrush" Color="{StaticResource MeterSafeColor}" />
            <SolidColorBrush x:Key="PreviewBackdropBrush" Color="{StaticResource PreviewBackdropColor}" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="{StaticResource OverlayBackgroundColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="AppBackgroundColor">#FF1F1A08</Color>
            <Color x:Key="CardSurfaceColor">#FF2E2710</Color>
            <Color x:Key="CardSubtleSurfaceColor">#FF423817</Color>
            <Color x:Key="CardStrokeColor">#FF5C4E22</Color>
            <Color x:Key="PrimaryTextColor">#FFFFF8E1</Color>
            <Color x:Key="SecondaryTextColor">#FFD4C48A</Color>
            <Color x:Key="BrandAccentColor">#FFFFC94D</Color>
            <Color x:Key="RecordingActiveColor">#FFEF5350</Color>
            <Color x:Key="RecordingPausedColor">#FFFFA726</Color>
            <Color x:Key="MeterSafeColor">#FF81C784</Color>
            <Color x:Key="PreviewBackdropColor">#FF120F05</Color>
            <Color x:Key="OverlayBackgroundColor">#F22E2710</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
            <SolidColorBrush x:Key="CardSubtleSurfaceBrush" Color="{StaticResource CardSubtleSurfaceColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="RecordingActiveBrush" Color="{StaticResource RecordingActiveColor}" />
            <SolidColorBrush x:Key="RecordingPausedBrush" Color="{StaticResource RecordingPausedColor}" />
            <SolidColorBrush x:Key="MeterSafeBrush" Color="{StaticResource MeterSafeColor}" />
            <SolidColorBrush x:Key="PreviewBackdropBrush" Color="{StaticResource PreviewBackdropColor}" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="{StaticResource OverlayBackgroundColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
