<Page
    x:Class="Com.VibeCode.CourseRec.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="{StaticResource PageContentPadding}">
        <StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="AboutPageTitle" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Uid="AboutPageSubtitle" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <InfoBar
                x:Name="StatusInfoBar"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="AboutSectionInfo" Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.VersionDisplayText}" Style="{StaticResource BodyPrimaryTextStyle}" />
                    <TextBlock x:Uid="AboutPrivacyAndLicense" Style="{StaticResource CaptionSecondaryTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="BtnAboutOpenOutputFolder"
                            Command="{x:Bind ViewModel.OpenOutputFolderCommand}" />
                        <Button
                            x:Uid="BtnAboutOpenLogFolder"
                            Command="{x:Bind ViewModel.OpenLogFolderCommand}" />
                        <Button
                            x:Uid="BtnAboutCopyVersionInfo"
                            Command="{x:Bind ViewModel.CopyVersionInfoCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
